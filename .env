# ⚠️ 上线前检查：grep -rn "【上线前" . --exclude-dir=node_modules --exclude-dir=dist --exclude-dir=docs
#    （本文件不在版本控制里，所以要跟着部署走的说明写在 .env.example）

# === 前端（VITE_ 前缀的才会暴露到浏览器） ===
VITE_BASE_URL=/
# 后端接口地址（开发默认值；生产由 .env.production 覆盖为空格，无需手动改本文件）
#  - 开发（npm run dev）：http://127.0.0.1:3000（前端直连本地后端）
#  - 生产（npm run build）：留空，前端用「同源相对路径」请求 /api/...，由 Nginx 反代到 127.0.0.1:3000
#  ⚠️ 生产不要填绝对域名（www/裸域之间会跨域），更不要带 /api 后缀（会拼成 /api/api）。
VITE_API_BASE_URL=http://127.0.0.1:3000
VITE_MOCK_ADMIN_USERNAME=admin
VITE_MOCK_ADMIN_PASSWORD=admin123

# === 后端（Node.js process.env 读取，无前缀） ===
# JWT 密钥：沙箱隔离的全部安全性都建立在「token 是服务端签的、密钥不可猜」之上，
# 所以这里必须是随机长串，且绝不能带 VITE_ 前缀（会被打包进前端 bundle 公开下发）。
# 轮换此值会让所有已签发的 token 立即失效（所有人重新登录一次）
JWT_SECRET=9149c0edc7dad875d81e3405936b687ba311d91c5554b6b187a49cbc6f311634ccefe7fce4623dc441b4c7c55debdd09
PORT=3000

ALLOW_TEMPLATE_WRITE=1
