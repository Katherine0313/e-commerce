# 上线前检查：grep -rn "【上线前" . --exclude-dir=node_modules --exclude-dir=dist --exclude-dir=docs

# === 前端（VITE_ 前缀的才会暴露到浏览器） ===
VITE_BASE_URL=/
# 【上线前必改】改成线上后端地址；VITE_ 是构建时打进产物的，改完必须重新 npm run build
VITE_API_BASE_URL=http://127.0.0.1:3000
VITE_MOCK_ADMIN_USERNAME=admin
VITE_MOCK_ADMIN_PASSWORD=  # mock 管理员默认密码，请修改

# === 后端（Node.js process.env 读取，无前缀） ===
# JWT 签名密钥：必须是随机长串，且**不要**加 VITE_ 前缀（那样会打包进前端 bundle 公开下发）。
# 缺失时服务会拒绝启动（见 server/util/jwt.js），这是刻意的
JWT_SECRET=
PORT=3000

# 模板店（shop_id=1）默认禁止写入，它是所有体验沙箱的数据源。
# 本地维护演示素材时设为 1 并重启服务
# 【上线前必删】腾讯云那份 .env 里绝不能带这一行：开关是全局的，带上它
#   访客拿公开的 admin123 登进模板店就能写，模板被改脏会污染之后每一个新沙箱
# ALLOW_TEMPLATE_WRITE=1
